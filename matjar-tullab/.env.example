# انسخ هذا الملف باسم .env وعبّي القيم الحقيقية (لا ترفع ملف .env على GitHub أبداً)

# رابط الاتصال بقاعدة بيانات MongoDB Atlas (من Atlas Dashboard -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/matjar-tullab?retryWrites=true&w=majority

# رابط الاتصال بـ Cloudinary (من Cloudinary Dashboard -> Account Details -> API Environment variable)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
